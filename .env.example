# ─── Railway & Node Configuration ─────────────────────────────────────────────
# Automatically provided by Railway:
# PORT=3000
# Node version used by Nixpacks builder (must be >= 22.12.0 for Vite + Rolldown):
NIXPACKS_NODE_VERSION=22.14.0

# ─── Admin Panel Security ─────────────────────────────────────────────────────
# Password to access orders management sheet modal (shortcut: Ctrl+Shift+O)
ADMIN_PASSWORD=TwojeBezpieczneHaslo2026!
ADMIN_PIN=1234

# ─── Optional: Online Payments (Stripe / BLIK) ────────────────────────────────
# If left empty, the store operates in simulated/COD mode with instant confirmation
STRIPE_SECRET_KEY=sk_test_...

# ─── Optional: Google Sheets Order Sync ───────────────────────────────────────
# Google Apps Script Webhook URL to automatically log orders in Google Sheets
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# ─── Optional: Email Order Notifications (SMTP) ──────────────────────────────
# Recipient address for instant email alerts when a customer places an order
NOTIFICATION_EMAIL=twoj-email@gmail.com

# SMTP sender credentials (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=twoj-email@gmail.com
SMTP_PASS=twoje_haslo_aplikacji_google
